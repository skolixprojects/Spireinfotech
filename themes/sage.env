# Sage IT Consulting — template. Fill in the # FIXME values once
# brand assets land (logo, primary color, address, etc.), then
# mirror into Vercel + Railway env vars exactly as Spire does.

# ── Frontend (Vercel: NEXT_PUBLIC_BRAND_*) ────────────────────────
NEXT_PUBLIC_BRAND_NAME=Sage IT Consulting
NEXT_PUBLIC_BRAND_SHORT_NAME=Sage
NEXT_PUBLIC_BRAND_LEGAL_NAME=Sage IT Consulting
NEXT_PUBLIC_BRAND_TAGLINE=# FIXME — Sage tagline
NEXT_PUBLIC_BRAND_LOGO_URL=/sage-logo.png
NEXT_PUBLIC_BRAND_LOGO_ALT=Sage IT Consulting logo
NEXT_PUBLIC_BRAND_FAVICON=/sage-favicon.ico
NEXT_PUBLIC_BRAND_PRIMARY=# FIXME — Sage primary (e.g. #1E3A8A)
NEXT_PUBLIC_BRAND_PRIMARY_DARK=# FIXME — Sage primary dark
NEXT_PUBLIC_BRAND_PRIMARY_LIGHT=# FIXME — Sage primary light
NEXT_PUBLIC_BRAND_ACCENT=# FIXME — Sage accent
NEXT_PUBLIC_BRAND_CONTACT_EMAIL=info@sageitco.com
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@sageitco.com
NEXT_PUBLIC_BRAND_NOREPLY_EMAIL=noreply@sageitco.com
NEXT_PUBLIC_BRAND_ADDRESS_LINE1=# FIXME
NEXT_PUBLIC_BRAND_ADDRESS_LINE2=# FIXME
NEXT_PUBLIC_BRAND_CITY=# FIXME
NEXT_PUBLIC_BRAND_STATE=# FIXME
NEXT_PUBLIC_BRAND_POSTAL_CODE=# FIXME
NEXT_PUBLIC_BRAND_COUNTRY=# FIXME
NEXT_PUBLIC_BRAND_WEBSITE=https://portal.sageitco.com
NEXT_PUBLIC_BRAND_MARKETING_SITE=https://sageitco.com
NEXT_PUBLIC_BRAND_ID_PREFIX=SAGE

# ── Backend (Railway: BRAND_*) ────────────────────────────────────
BRAND_NAME=Sage IT Consulting
BRAND_SHORT_NAME=Sage
BRAND_LEGAL_NAME=Sage IT Consulting
BRAND_TAGLINE=# FIXME — Sage tagline
BRAND_CONTACT_EMAIL=info@sageitco.com
BRAND_SUPPORT_EMAIL=support@sageitco.com
BRAND_NOREPLY_EMAIL=noreply@sageitco.com
BRAND_ADDRESS_LINE1=# FIXME
BRAND_ADDRESS_LINE2=# FIXME
BRAND_CITY=# FIXME
BRAND_STATE=# FIXME
BRAND_POSTAL_CODE=# FIXME
BRAND_COUNTRY=# FIXME
BRAND_WEBSITE=https://portal.sageitco.com
BRAND_ID_PREFIX=SAGE
BRAND_PRIMARY_COLOR=# FIXME
BRAND_PRIMARY_COLOR_DARK=# FIXME
BRAND_LETTERHEAD_PATH=templates/sage_letterhead.pdf
BRAND_LOGO_URL=https://portal.sageitco.com/sage-logo.png

# ── Mail module (Railway: backend) ────────────────────────────────
# Internal mail system. MAIL_JWT_SECRET must be a long random string,
# DISTINCT from JWT_SECRET. Bootstrap the first SUPER_ADMIN by setting
# SEED_MAIL_ADMIN=true + the MAIL_ADMIN_* vars for ONE deploy, then
# set SEED_MAIL_ADMIN=false. Never commit a real MAIL_ADMIN_PASSWORD.
MAIL_JWT_SECRET=# FIXME — long random secret, distinct from JWT_SECRET
SEED_MAIL_ADMIN=false
MAIL_ADMIN_EMAIL=admin@sageitco.com
MAIL_ADMIN_PASSWORD=
MAIL_ADMIN_ENTITY=Sage IT Consulting
# Validity (hours) of admin-issued one-time setup/reset links.
MAIL_LINK_EXPIRY_HOURS=72
# Max attachment upload size in bytes (default 25 MB).
MAIL_ATTACHMENT_MAX_BYTES=26214400
# Mail attachment storage (Amazon S3, private bucket). Set these in prod to
# store attachments in S3; leave unset for the local-disk dev fallback.
# Downloads still stream through the walled proxy (no presigned URLs).
# Credentials use the default AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
