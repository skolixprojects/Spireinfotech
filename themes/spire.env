# Spire Info Tech — default brand. Mirror these into Vercel
# (NEXT_PUBLIC_BRAND_*) for the frontend and Railway (BRAND_*) for
# the backend. They are the defaults baked into the code, but
# setting them explicitly removes any ambiguity about which brand
# a given deployment is serving.

# ── Frontend (Vercel: NEXT_PUBLIC_BRAND_*) ────────────────────────
NEXT_PUBLIC_BRAND_NAME=Spire Info Tech
NEXT_PUBLIC_BRAND_SHORT_NAME=Spire
NEXT_PUBLIC_BRAND_LEGAL_NAME=Spire Info Tech
NEXT_PUBLIC_BRAND_TAGLINE=Advance your career with expert coaching and personalized guidance
NEXT_PUBLIC_BRAND_LOGO_URL=/logo.png
NEXT_PUBLIC_BRAND_LOGO_ALT=Spire Info Tech logo
NEXT_PUBLIC_BRAND_FAVICON=/favicon.ico
NEXT_PUBLIC_BRAND_PRIMARY=#0F766E
NEXT_PUBLIC_BRAND_PRIMARY_DARK=#115E59
NEXT_PUBLIC_BRAND_PRIMARY_LIGHT=#E6F7F5
NEXT_PUBLIC_BRAND_ACCENT=#D97706
NEXT_PUBLIC_BRAND_CONTACT_EMAIL=info@spireitco.com
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@spireitco.com
NEXT_PUBLIC_BRAND_NOREPLY_EMAIL=noreply@spireitco.com
NEXT_PUBLIC_BRAND_ADDRESS_LINE1=H No. 2-91/5, Flat No. 1605
NEXT_PUBLIC_BRAND_ADDRESS_LINE2=Trendset Jayabheri Enclave, Hitech City
NEXT_PUBLIC_BRAND_CITY=Hyderabad
NEXT_PUBLIC_BRAND_STATE=Telangana
NEXT_PUBLIC_BRAND_POSTAL_CODE=500084
NEXT_PUBLIC_BRAND_COUNTRY=India
NEXT_PUBLIC_BRAND_WEBSITE=https://spireinfotech.vercel.app
NEXT_PUBLIC_BRAND_MARKETING_SITE=https://spireinfotech.vercel.app
NEXT_PUBLIC_BRAND_ID_PREFIX=SIT

# ── Backend (Railway: BRAND_*) ────────────────────────────────────
BRAND_NAME=Spire Info Tech
BRAND_SHORT_NAME=Spire
BRAND_LEGAL_NAME=Spire Info Tech
BRAND_TAGLINE=Advance your career with expert coaching and personalized guidance
BRAND_CONTACT_EMAIL=info@spireitco.com
BRAND_SUPPORT_EMAIL=support@spireitco.com
BRAND_NOREPLY_EMAIL=noreply@spireitco.com
BRAND_ADDRESS_LINE1=H No. 2-91/5, Flat No. 1605
BRAND_ADDRESS_LINE2=Trendset Jayabheri Enclave, Hitech City
BRAND_CITY=Hyderabad
BRAND_STATE=Telangana
BRAND_POSTAL_CODE=500084
BRAND_COUNTRY=India
BRAND_WEBSITE=https://spireinfotech.vercel.app
BRAND_ID_PREFIX=SIT
BRAND_PRIMARY_COLOR=#0F766E
BRAND_PRIMARY_COLOR_DARK=#115E59
BRAND_LETTERHEAD_PATH=templates/letterhead.pdf
BRAND_LOGO_URL=https://spireinfotech.vercel.app/logo.png

# ── Mail module (Railway: backend) ────────────────────────────────
# Internal mail system. MAIL_JWT_SECRET must be a long random string,
# DISTINCT from JWT_SECRET. Bootstrap the first SUPER_ADMIN by setting
# SEED_MAIL_ADMIN=true + the MAIL_ADMIN_* vars for ONE deploy, then
# set SEED_MAIL_ADMIN=false. Never commit a real MAIL_ADMIN_PASSWORD.
MAIL_JWT_SECRET=change-me-to-a-long-random-secret-distinct-from-jwt-secret
SEED_MAIL_ADMIN=false
MAIL_ADMIN_EMAIL=admin@spireitco.com
MAIL_ADMIN_PASSWORD=
MAIL_ADMIN_ENTITY=Spire Info Tech
# Validity (hours) of admin-issued one-time setup/reset links.
MAIL_LINK_EXPIRY_HOURS=72
